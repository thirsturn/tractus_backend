### Get all users
GET http://localhost:8081/api/users
Accept: application/json

### Create a new user
POST http://localhost:8081/api/users
Content-Type: application/json

{
  "username": "johndoe",
  "email": "john.doe@example.com",
  "passwordHash": "hashed_password_placeholder",
  "bio": "A passionate developer."
}

### Get all spaces
GET http://localhost:8081/api/spaces
Accept: application/json

### Create a new space
POST http://localhost:8081/api/spaces
Content-Type: application/json

{
  "name": "General Discussion",
  "description": "A place for general topics."
}

### Get threads in a space (Assuming spaceId is 1, modify as needed)
GET http://localhost:8081/api/threads/space/1
Accept: application/json

### Create a new thread
POST http://localhost:8081/api/threads
Content-Type: application/json

{
  "title": "Welcome to Tractus",
  "content": "This is our first thread!",
  "author": {
    "id": 1
  },
  "space": {
    "id": 1
  }
}
